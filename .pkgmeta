package-as: AltStableSync

# Released on CurseForge (project 1733555, altstable-sync-forever-edition):
# CurseForge's packager builds a release from each tag pushed to main.
enable-nolib-creation: no

# The upload's changelog: each release gets a "## vX.Y.Z" heading before
# it is tagged.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# LibStub is vendored in Libs/. The externals are pinned to TAGS (never
# "latest"), bumped only in a release made anyway. LibAccountSync goes into the
# Link addon only, so its store (the household key) is written to
# AltStableSyncLink.lua and never to AltStableSync.lua (#18). External keys
# are paths from the project root; move-folders paths include the package name.
# Comments on their own lines only - the packager's YAML reader keeps an inline
# "# ..." as part of the value (measured in GlassUnitFrames' migration).
externals:
  # r5: what the v0.1.0 panel was tried with in game (only tests and docs
  # changed after it).
  Libs/LibGlass-1.0:
    url: https://github.com/Spotnick2/LibGlass
    tag: r5
  # r5 (76fedef): messages mode and SendTo, both required by Link.lua.
  Plugins/Link/Libs/LibAccountSync-1.0:
    url: https://github.com/Spotnick2/LibAccountSync
    tag: r5

# WoW only discovers top-level addon folders: the packager moves the Link
# addon out of the core folder (AltStable's and GlassChat's pattern).
move-folders:
  AltStableSync/Plugins/Link: AltStableSyncLink

# YAML list, not markdown bullets. Ignores match from the package root, and
# CurseForge's packager does not honour an external's own ignore list, so the
# library's development files are repeated here. Its LICENSE ships (MIT).
ignore:
  - .github
  - .claude
  - docs
  - tests
  - Tools
  - AGENTS.md
  - CLAUDE.md
  - README.md
  - README.curseforge.md
  - CHANGELOG.md
  - Libs/LibGlass-1.0/tests
  - Libs/LibGlass-1.0/docs
  - Libs/LibGlass-1.0/Tools
  - Libs/LibGlass-1.0/AGENTS.md
  - Libs/LibGlass-1.0/CLAUDE.md
  - Libs/LibGlass-1.0/README.md
  # LibAccountSync's own non-shipped paths. Its ChatThrottleLib/ and LibStub/
  # ship: its XML loads them.
  - Plugins/Link/Libs/LibAccountSync-1.0/tests
  - Plugins/Link/Libs/LibAccountSync-1.0/docs
  - Plugins/Link/Libs/LibAccountSync-1.0/Tools
  - Plugins/Link/Libs/LibAccountSync-1.0/CLAUDE.md
  - Plugins/Link/Libs/LibAccountSync-1.0/README.md
  # The same paths with the package name: CurseForge's packager shipped the
  # entries above in v0.1.0 (#66), though BigWigs honours them. Its guide
  # applies ignores BEFORE move-folders, so these name the folder before the
  # move, from the package root. Confirmed only by a CurseForge build.
  - AltStableSync/Plugins/Link/Libs/LibAccountSync-1.0/tests
  - AltStableSync/Plugins/Link/Libs/LibAccountSync-1.0/docs
  - AltStableSync/Plugins/Link/Libs/LibAccountSync-1.0/Tools
  - AltStableSync/Plugins/Link/Libs/LibAccountSync-1.0/CLAUDE.md
  - AltStableSync/Plugins/Link/Libs/LibAccountSync-1.0/README.md
